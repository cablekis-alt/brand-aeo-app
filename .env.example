PORT=4000

# true로 두면 실제 API 키 없이 목(mock) 엔진으로 파이프라인 배선을 테스트할 수 있다.
USE_MOCK_ENGINES=false

# 수집용 4개 엔진
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# 각 엔진 모델명. 기본값은 2026-09 기준 추정치이므로 배포 전 각 제공사 문서에서 재확인할 것.
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-3.7-flash
CLAUDE_MODEL=claude-sonnet-5

# B1/B5/B8 분석·생성 전용 고정 모델 (수집용 엔진과 별도, ANTHROPIC_API_KEY 재사용)
JUDGE_MODEL=claude-opus-5

# 판정(judge) 엔진 선택. 비우면 ANTHROPIC 키 있으면 Claude, 없으면 OpenAI.
# OpenAI 크레딧이 없을 땐 'gemini'로 두면 판정까지 Gemini로 돌아간다.
JUDGE_ENGINE=gemini

# scripts/measure-requests.ts가 배포 대기열을 읽을 기준 URL (로컬에서만 사용).
MEASURE_API_BASE=https://brand-aeo-app.vercel.app

# 매주 월요일 03:00 (분 시 일 월 요일). node-cron 문법.
PIPELINE_CRON=0 3 * * 1

# Vercel 프로덕션에서 S-08 브랜드 자동 등록 (Vercel Blob 토큰).
# 대시보드 Storage → Blob에서 스토어를 만든 뒤 vercel env pull 또는 대시보드에 넣는다.
BLOB_READ_WRITE_TOKEN=

# 배포 S-12에서 GitHub Actions 측정을 켜려면 PAT가 필요하다.
# 권한: Actions Read and write (해당 저장소). Vercel Production env에 넣고,
# GitHub repo Secrets에도 OPENAI_API_KEY / BLOB_READ_WRITE_TOKEN 을 넣는다.
GH_MEASURE_TOKEN=
# Vercel Git 연동이 있으면 생략 가능. 아니면 owner / repo / branch 를 적는다.
GITHUB_MEASURE_OWNER=
GITHUB_MEASURE_REPO=
GITHUB_MEASURE_REF=master

# --- GitHub 측정을 켜기 위한 준비 (이 파일이 아니라 각 플랫폼에 설정) ---
# 1) GitHub 저장소에 push (지금은 git 리모트가 없음).
# 2) GitHub repo Secrets: GEMINI_API_KEY, BLOB_READ_WRITE_TOKEN (필요시 OPENAI/ANTHROPIC_API_KEY),
#    그리고 JUDGE_ENGINE=gemini.
# 3) Vercel Production env: GH_MEASURE_TOKEN (Actions 쓰기 PAT).
# 4) 배포 루프: Vercel을 그 GitHub 저장소에 연동하면 push가 배포를 트리거.
#    CLI 배포 유지 시엔 GitHub repo Secrets에 VERCEL_TOKEN / VERCEL_ORG_ID / VERCEL_PROJECT_ID 를 넣으면
#    measure.yml의 배포 스텝이 대신 배포한다.
