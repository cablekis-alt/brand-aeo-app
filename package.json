{
  "name": "brand-aeo-app",
  "private": true,
  "version": "0.1.0",
  "description": "Web4AI Brand AEO — 답변 엔진 브랜드 가시성 콘솔",
  "author": "O2O",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server:dev": "tsx watch --ignore \"**/tenants.config.json\" --ignore \"**/liveRegistry.ts\" --ignore \"src/data/**\" --ignore \"**/*.overlay.json\" --ignore \"**/measure-requests.json\" server/index.ts",
    "server:start": "tsx server/index.ts",
    "measure:local": "tsx scripts/measure-local.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "electron:dev": "electron .",
    "electron:server": "node scripts/build-electron-server.mjs",
    "electron:pack:dir": "npm run build && npm run electron:server && electron-builder --dir",
    "electron:pack": "npm run build && npm run electron:server && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/genai": "^2.20.0",
    "@vercel/blob": "^2.8.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
