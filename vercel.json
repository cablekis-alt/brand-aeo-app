{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/infer.ts": {
      "includeFiles": "{server/tenants.config.json,src/data/*.json}",
      "maxDuration": 60
    },
    "api/**/*.js": {
      "includeFiles": "{server/tenants.config.json,src/data/*.json}",
      "maxDuration": 20
    },
    "api/**/*.ts": {
      "includeFiles": "{server/tenants.config.json,src/data/*.json}",
      "maxDuration": 20
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
